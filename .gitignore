# SatQuery git root. Do not init git in the parent workspace
# (that folder also holds research_archive/, .venv/, tmp/).
#
# Local tree is ~31 GB. GitHub should be product code + frozen eval ids +
# the team brief. Weights, caches, archive, operator prompts, and the X1
# pack stay on this laptop.

# --- secrets ---
.secrets/
*.env
*.pem
.modal.toml
huggingface_token
HF_TOKEN

# --- python / os ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
tmp/


# SatQuery git root. Do not `git init` in the parent workspace
# (that folder also holds research_archive/, .venv/, tmp/).
#
# GitHub should be product code + the team brief.
# Weights, caches, and the laptop board stay on this machine.

# --- secrets ---
.secrets/
*.env
*.pem
.modal.toml
huggingface_token
HF_TOKEN

# --- python / os ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
tmp/

# --- weights, checkpoints, binary runtimes ---
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.zip
*.dll
*.exe
ollama_models/
models/

# --- gates: serving runtime (not in git) ---
gates/_cache/
gates/qwen3vl/

# --- demo runtime (scenes regenerated by demo/prepare_scenes.py) ---
demo/data/
demo/_vendor/
demo/traces/
demo/reports/
demo/*.mp4
demo/*.log
demo/*.pid


# --- laptop-only board + strategy memos ---
ops/
strategy/MASTER_ARCHITECTURE_AND_STRATEGY.md
strategy/sol_responses.md

# --- logs / pids anywhere ---
*.log
*.pid

# --- judge kit: user drops + generated rehearsal outputs (code stays) ---
judge_kit/inbox/**
!judge_kit/inbox/.gitkeep
judge_kit/rehearsal/preds.jsonl
judge_kit/rehearsal/MANIFEST.txt
judge_kit/rehearsal/scores.json
judge_kit/rehearsal/traces/
judge_kit/rehearsal/failure_proof/

# --- REPO-PREP 2026-09-22: heavy local-only artifacts (eval lanes) ---
# raw pred shards are large + regenerable; manifests/metrics/REPORTs commit
eval_*/**/preds_*.jsonl
eval_lr_fold/final/preds/
# LR-FOLD lane staging + rolling ckpt (regenerable / resume-only)
eval_lr_fold/staging/
eval_lr_fold/run/
eval_lr_fold/ckpt_final/
eval_lr_fold/vol_repack/
eval_lr_fold/mix_lr_fold.jsonl
# durable local volume mirror (2.6GB — never commits)
modal_volume_backup/
# old transfer/verify scratch dirs (pending user cleanup)
_xfer_h610/
_verify/
.obsidian/
# stray Windows redirect artifacts
nul
demo/nul
%TEMP%*

# runtime control flag (sync-loop mechanism, like *.pid)
eval_lr_fold/STOP_SYNC

# strategy/planning docs — private lane records (same class as ops/)
strategy/MASTER_PLAN_V2.md
strategy/README.md
